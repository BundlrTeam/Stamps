# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

# ─── Temp / OS files ────────────────────────────────────────────────────────
*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
$RECYCLE.BIN/
.DS_Store
Thumbs.db
Desktop.ini
UserInterfaceState.xcuserstate

# ─── Logs ───────────────────────────────────────────────────────────────────
*.log
log.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ─── Node ───────────────────────────────────────────────────────────────────
node_modules/

# ─── Compiled output ────────────────────────────────────────────────────────
/dist
/tmp
/out-tsc
/bazel-out

# ─── Angular ────────────────────────────────────────────────────────────────
/.angular
/.angular/cache

# ─── Ionic / Capacitor ──────────────────────────────────────────────────────
/.ionic
/www
/platforms
/plugins
/.sourcemaps
/.versions
/coverage

# ─── Test / Build artefacts ─────────────────────────────────────────────────
/libpeerconnection.log
testem.log
/typings
/connect.lock

# ─── IDEs and editors ───────────────────────────────────────────────────────
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-project
*.sublime-workspace

# ─── Visual Studio Code ─────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# ─── SCSS / SASS cache ──────────────────────────────────────────────────────
.sass-cache/

# ─── Nx ─────────────────────────────────────────────────────────────────────
/.nx
/.nx/cache

# ─── Environment / Secrets ──────────────────────────────────────────────────
.env
.env.*
!.env.example
google-services.json
GoogleService-Info.plist

# ─── Package manager lock files (keep only one) ─────────────────────────────
# Specifies intentionally untracked files to ignore when using Git
